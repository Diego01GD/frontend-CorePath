# Copia como .env.local (desarrollo) y configura las mismas variables en Vercel (producción).
# Solo valores públicos: NUNCA la service_role de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backend FastAPI: local o la URL fija de ngrok (https://tu-dominio.ngrok-free.app)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Dominios de correo permitidos, separados por coma (deben coincidir con el backend y el hook)
NEXT_PUBLIC_DOMINIOS_CORREO=merida.tecnm.mx
# true cuando el proveedor Azure esté activo en Supabase
NEXT_PUBLIC_LOGIN_MICROSOFT=false
